<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.arthuros"
       version="0.9.6"
       name="ArthurOS"
       provider-name="Vince">
  <requires>
    <import addon="xbmc.gui" version="5.17.0"/>
  </requires>
  <extension point="xbmc.gui.skin" debugging="false" effectslowdown="1.0">
    <res width="1024" height="600" aspect="16:9" default="true" folder="xml" />
    <res width="1024" height="768" aspect="4:3" folder="xml768" />
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
    <summary lang="en_GB">Arthur 1.2 desktop skin for Kodi</summary>
    <description lang="en_GB">A 16-colour pixel skin in the style of Acorn's Arthur 1.2 desktop. Built for 1024x600 panels and 4:3 screens such as an iPad 3 panel (1024x768, drawn at 2x on 2048x1536), driven by remote, mouse or touch.</description>
  </extension>
</addon>
