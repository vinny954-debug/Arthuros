<?xml version='1.0' encoding='UTF-8'?>
<window>
  <defaultcontrol always="false">52</defaultcontrol>
  <backgroundcolor>desktop</backgroundcolor>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1024</width><height>768</height>
      <texture colordiffuse="desktop">fill.png</texture>
    </control>
    <control type="group">
      <left>0</left><top>0</top><width>1024</width><height>26</height>
      <visible>!Skin.HasSetting(hidemenubar)</visible>

      <control type="image">
        <left>0</left><top>0</top><width>1024</width><height>26</height>
        <texture border="2" colordiffuse="facetint">panel_chrome.png</texture>
      </control>

      <control type="image">
        <left>5</left><top>5</top><width>16</width><height>16</height>
        <texture>logo.png</texture>
      </control>

      <control type="label">
        <left>27</left><top>0</top><width>520</width><height>26</height>
        <font>chromebold</font><textcolor>text</textcolor>
        <align>left</align><aligny>center</aligny>
        <label>Kodi $INFO[System.BuildVersionShort] - ArthurOS 1.2 (v0.9.6)</label>
      </control>

      <!-- right-hand status cluster, anchored to the right edge -->
      <control type="image">
        <right>6</right><top>5</top><width>16</width><height>16</height>
        <texture>icons24/network.png</texture>
        <visible>System.InternetState</visible>
      </control>

      <control type="image">
        <right>100</right><top>5</top><width>16</width><height>16</height>
        <texture>$VAR[VolumeIconVar]</texture>
      </control>
      <!-- a small volume gauge instead of Kodi's decibel figure -->
      <control type="progress">
        <right>28</right><top>8</top><width>66</width><height>10</height>
        <info>Player.Volume</info>
        <visible>!Player.Muted</visible>
      </control>
      <control type="label">
        <right>28</right><top>0</top><width>66</width><height>26</height>
        <font>chromesmall</font><textcolor>marked</textcolor>
        <align>center</align><aligny>center</aligny>
        <label>$LOCALIZE[31949]</label>
        <visible>Player.Muted</visible>
      </control>

      <control type="label">
        <right>124</right><top>0</top><width>300</width><height>26</height>
        <font>chromebold</font><textcolor>text</textcolor>
        <align>right</align><aligny>center</aligny>
        <label>$INFO[System.Date(ddd mmm d)]  $INFO[System.Time]</label>
        <visible>!Skin.HasSetting(hideclock)</visible>
      </control>
    </control>
    <control type="group">
      <left>6</left><top>30</top><width>1012</width><height>702</height>
      <control type="image">
        <left>0</left><top>0</top>
        <width>1012</width><height>702</height>
        <texture border="2" colordiffuse="facetint">panel_raised.png</texture>
      </control>
      <control type="group">
        <left>3</left><top>3</top>
        <control type="group">
        <width>1006</width><height>26</height>

        <control type="image">
          <left>0</left><top>0</top>
          <width>1006</width><height>26</height>
          <texture colordiffuse="accent2">fill.png</texture>
        </control>
        <!-- hard 1px rule under the bar, the way Arthur draws it -->
        <control type="image">
          <left>0</left><bottom>0</bottom>
          <width>1006</width><height>1</height>
          <texture>fill_black.png</texture>
        </control>

        <control type="image">
          <left>4</left><top>5</top><width>16</width><height>16</height>
          <texture>icons24/person.png</texture>
        </control>

        <!-- left + right with no width: Kodi derives the width, so the title
             stops before the window boxes instead of running underneath them -->
        <control type="label">
          <left>26</left><include content="WinTitle_Right_Mouse" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinTitle_Right_Touch" condition="Skin.HasSetting(touchmode)"/><top>0</top><height>26</height>
          <align>left</align><aligny>center</aligny>
          <font>chromebold</font><textcolor>titletext</textcolor>
          <label>$LOCALIZE[20096]</label>
        </control>

        <control type="label">
          <include content="WinTitle_Right_Mouse" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinTitle_Right_Touch" condition="Skin.HasSetting(touchmode)"/><top>0</top><width>460</width><height>26</height>
          <align>right</align><aligny>center</aligny>
          <font>chromesmall</font><textcolor>titletext</textcolor>
          <label></label>
        </control>

        <!-- The window boxes. Which set a title bar gets is chosen by the
             "boxes" parameter: window, dialog, home or none. -->
        <control type="group"/>
      </control>
      </control>
      <control type="label" id="2">
        <left>16</left><top>38</top><width>980</width><height>26</height>
        <font>bigbold</font><textcolor>text</textcolor><align>left</align><aligny>center</aligny>
      </control>
      <control type="label" id="3">
        <left>16</left><top>66</top><width>980</width><height>22</height>
        <font>small</font><textcolor>textdim</textcolor><align>left</align><aligny>center</aligny>
      </control>
      <control type="image">
        <left>6</left><top>94</top><width>1000</width><height>548</height>
        <texture border="2" colordiffuse="facetint">panel_sunken.png</texture>
      </control>
      <control type="list" id="52">
        <left>9</left><top>97</top><width>976</width><height>542</height>
        <onup>9000</onup><ondown>9000</ondown><onleft>52</onleft><onright>60</onright>
        <pagecontrol>60</pagecontrol>
        <itemlayout height="72" width="976" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]">
          <control type="image"><left>6</left><top>12</top><width>48</width><height>48</height><texture fallback="icons/person.png">$INFO[ListItem.Icon]</texture><aspectratio>keep</aspectratio></control>
          <control type="label"><left>66</left><top>12</top><width>900</width><height>26</height><font>bigbold</font><textcolor>text</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label]</label></control>
          <control type="label"><left>66</left><top>38</top><width>900</width><height>22</height><font>small</font><textcolor>textdim</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label2]</label></control>
        </itemlayout>
        <focusedlayout height="72" width="976" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]">
          <control type="image"><left>0</left><top>0</top><width>976</width><height>72</height><texture colordiffuse="select">fill.png</texture></control>
          <control type="image"><left>6</left><top>12</top><width>48</width><height>48</height><texture fallback="icons/person.png">$INFO[ListItem.Icon]</texture><aspectratio>keep</aspectratio></control>
          <control type="label"><left>66</left><top>12</top><width>900</width><height>26</height><font>bigbold</font><textcolor>textinv</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label]</label></control>
          <control type="label"><left>66</left><top>38</top><width>900</width><height>22</height><font>small</font><textcolor>textinv</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label2]</label></control>
        </focusedlayout>
      <itemlayout height="56" width="976">
          <control type="image"><left>6</left><top>4</top><width>48</width><height>48</height><texture fallback="icons/person.png">$INFO[ListItem.Icon]</texture><aspectratio>keep</aspectratio></control>
          <control type="label"><left>66</left><top>4</top><width>900</width><height>26</height><font>bigbold</font><textcolor>text</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label]</label></control>
          <control type="label"><left>66</left><top>30</top><width>900</width><height>22</height><font>small</font><textcolor>textdim</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label2]</label></control>
        </itemlayout>
        <focusedlayout height="56" width="976">
          <control type="image"><left>0</left><top>0</top><width>976</width><height>56</height><texture colordiffuse="select">fill.png</texture></control>
          <control type="image"><left>6</left><top>4</top><width>48</width><height>48</height><texture fallback="icons/person.png">$INFO[ListItem.Icon]</texture><aspectratio>keep</aspectratio></control>
          <control type="label"><left>66</left><top>4</top><width>900</width><height>26</height><font>bigbold</font><textcolor>textinv</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label]</label></control>
          <control type="label"><left>66</left><top>30</top><width>900</width><height>22</height><font>small</font><textcolor>textinv</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label2]</label></control>
        </focusedlayout>
      </control>
      <control type="scrollbar" id="60">
        <left>985</left><top>97</top><width>18</width><height>542</height>
        <onleft>52</onleft><onright>52</onright>
      </control>
      <control type="grouplist" id="9000">
        <left>6</left><top>650</top><width>1000</width><height>40</height>
        <orientation>horizontal</orientation><align>center</align><itemgap>8</itemgap>
        <onup>52</onup><ondown>52</ondown>
        <control type="button" id="9100">
          <width>260</width><height>40</height>
          <align>center</align>
          <label>$LOCALIZE[13005]</label>
          <onclick>ActivateWindow(ShutdownMenu)</onclick>
        </control>
      </control>
    </control>
  </controls>
</window>