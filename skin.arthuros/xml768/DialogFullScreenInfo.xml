<?xml version='1.0' encoding='UTF-8'?>
<window>
  <defaultcontrol always="true">9012</defaultcontrol>
  <controls>
    <control type="button" id="9990">
      <left>0</left><top>0</top><width>1024</width><bottom>238</bottom>
      <texturefocus/>
      <texturenofocus/>
      <label/>
      <onclick>Dialog.Close(FullscreenInfo)</onclick>
      <onup>9012</onup>
      <ondown>9012</ondown>
      <onleft>9012</onleft>
      <onright>9012</onright>
    </control>
    <control type="group">
      <centerleft>50%</centerleft><bottom>0</bottom>
      <width>1024</width><height>238</height>
      <control type="image">
        <left>0</left><top>0</top>
        <width>1024</width><height>238</height>
        <texture border="2" colordiffuse="facetint">panel_raised.png</texture>
      </control>
      <control type="group">
        <left>3</left><top>3</top>
        <control type="group">
        <width>1018</width><height>26</height>

        <control type="image">
          <left>0</left><top>0</top>
          <width>1018</width><height>26</height>
          <texture colordiffuse="accent2">fill.png</texture>
        </control>
        <!-- hard 1px rule under the bar, the way Arthur draws it -->
        <control type="image">
          <left>0</left><bottom>0</bottom>
          <width>1018</width><height>1</height>
          <texture>fill_black.png</texture>
        </control>

        <control type="image">
          <left>4</left><top>5</top><width>16</width><height>16</height>
          <texture>icons24/file_info.png</texture>
        </control>

        <!-- left + right with no width: Kodi derives the width, so the title
             stops before the window boxes instead of running underneath them -->
        <control type="label">
          <left>26</left><include content="WinTitle_Right_Mouse" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinTitle_Right_Touch" condition="Skin.HasSetting(touchmode)"/><top>0</top><height>26</height>
          <align>left</align><aligny>center</aligny>
          <font>chromebold</font><textcolor>titletext</textcolor>
          <label>$INFO[VideoPlayer.Title]</label>
        </control>

        <control type="label">
          <include content="WinTitle_Right_Mouse" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinTitle_Right_Touch" condition="Skin.HasSetting(touchmode)"/><top>0</top><width>460</width><height>26</height>
          <align>right</align><aligny>center</aligny>
          <font>chromesmall</font><textcolor>titletext</textcolor>
          <label></label>
        </control>

        <!-- The window boxes. Which set a title bar gets is chosen by the
             "boxes" parameter: window, dialog, home or none. -->
        <control type="group"/>
      </control>
      </control>
      <control type="image">
        <left>8</left><top>34</top><width>120</width><height>196</height>
        <texture border="2" colordiffuse="facetint">panel_raised.png</texture>
      </control>
      <control type="image">
        <left>14</left><top>40</top><width>108</width><height>184</height>
        <texture fallback="DefaultVideo.png">$INFO[Player.Art(thumb)]</texture>
        <aspectratio>keep</aspectratio>
      </control>
      <control type="label">
        <left>136</left><top>34</top><width>880</width><height>26</height>
        <font>chrome</font><textcolor>textdim</textcolor><aligny>center</aligny>
        <label>$INFO[VideoPlayer.ChannelName,,   ]$INFO[VideoPlayer.Year,,   ]$INFO[VideoPlayer.Genre]</label>
      </control>
      <control type="image">
        <left>136</left><top>62</top><width>880</width><height>118</height>
        <texture border="2" colordiffuse="facetint">panel_sunken.png</texture>
      </control>
      <control type="textbox">
        <left>144</left><top>68</top><width>842</width><height>106</height>
        <font>small</font><pagecontrol>61</pagecontrol>
        <label>$INFO[VideoPlayer.Plot]</label>
      </control>
      <control type="scrollbar" id="61">
        <left>992</left><top>65</top><width>20</width><height>112</height>
        <onleft>9013</onleft><onright>9013</onright><ondown>9013</ondown><onup>9013</onup>
      </control>
      <control type="label">
        <left>136</left><top>186</top><width>300</width><height>44</height>
        <font>chrome</font><aligny>center</aligny>
        <label>$INFO[Player.Time] / $INFO[Player.Duration]</label>
      </control>
      <control type="grouplist" id="9013">
        <left>750</left><top>186</top><width>266</width><height>44</height>
        <orientation>horizontal</orientation><itemgap>6</itemgap>
        <onup>61</onup>
        <ondown>61</ondown>
        <control type="button" id="9011">
          <width>150</width><height>44</height>
          <font>chrome</font><label>$LOCALIZE[31806]</label>
          <onclick>Dialog.Close(FullscreenInfo)</onclick>
          <onclick>ActivateWindow(PlayerProcessInfo)</onclick>
        </control>
        <control type="button" id="9012">
          <width>110</width><height>44</height>
          <font>chrome</font><label>$LOCALIZE[15067]</label>
          <onclick>Dialog.Close(FullscreenInfo)</onclick>
        </control>
      </control>
    </control>
  </controls>
</window>