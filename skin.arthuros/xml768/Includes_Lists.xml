<?xml version="1.0" encoding="UTF-8"?>
<!-- ===================================================================
     Row and tile layouts. Everything is 24px-row based so text sits on
     whole pixels and the bitmap font stays crisp.
     =================================================================== -->
<includes>

  <!-- ========== plain row, used by Defaults.xml and simple lists ===== -->
  <include name="Arthur_ItemLayout">
    <param name="width" default="560" />
    <definition>
      <control type="image">
        <left>4</left><top>4</top><width>16</width><height>16</height>
        <texture>$INFO[ListItem.Icon]</texture>
      </control>
      <control type="label">
        <left>26</left><top>0</top>
        <width>$PARAM[width]</width><height>24</height>
        <font>normal</font><textcolor>text</textcolor>
        <align>left</align><aligny>center</aligny>
        <label>$INFO[ListItem.Label]</label>
      </control>
      <control type="label">
        <left>0</left><top>0</top>
        <width>$PARAM[width]</width><height>24</height>
        <font>small</font><textcolor>textdim</textcolor>
        <align>right</align><aligny>center</aligny>
        <label>$INFO[ListItem.Label2]</label>
        <visible>!ListItem.IsPlaying + !ListItem.IsResumable + !Integer.IsGreater(ListItem.PlayCount,0)</visible>
      </control>
      <!-- the same, moved in to clear the status mark -->
      <control type="label">
        <right>24</right><top>0</top><height>24</height>
        <font>small</font><textcolor>textdim</textcolor>
        <align>right</align><aligny>center</aligny>
        <label>$INFO[ListItem.Label2]</label>
        <visible>ListItem.IsPlaying | ListItem.IsResumable | Integer.IsGreater(ListItem.PlayCount,0)</visible>
      </control>
      <!-- now playing / part watched / watched, at the right-hand end -->
      <control type="image">
        <right>4</right><top>4</top><width>16</width><height>16</height>
        <texture>icons24/status_playing.png</texture>
        <visible>ListItem.IsPlaying</visible>
      </control>
      <control type="image">
        <right>4</right><top>4</top><width>16</width><height>16</height>
        <texture>icons24/status_resume.png</texture>
        <visible>ListItem.IsResumable + !ListItem.IsPlaying</visible>
      </control>
      <control type="image">
        <right>4</right><top>4</top><width>16</width><height>16</height>
        <texture>icons24/status_watched.png</texture>
        <visible>Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable + !ListItem.IsPlaying</visible>
      </control>
    </definition>
  </include>

