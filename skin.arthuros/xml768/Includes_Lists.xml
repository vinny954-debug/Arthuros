  <!-- ========== status badge for poster / icon tiles ================== -->
  <!-- left/top: the top-right corner of the art; bar*: a progress strip
       along the bottom of the art for part-watched items -->
  <include name="Arthur_TileStatus">
    <param name="left" default="0" />
    <param name="top" default="0" />
    <param name="barleft" default="0" />
    <param name="bartop" default="0" />
    <param name="barwidth" default="100" />
    <definition>
      <control type="image">
        <left>$PARAM[left]</left><top>$PARAM[top]</top><width>16</width><height>16</height>
        <texture>icons24/status_playing.png</texture>
        <visible>ListItem.IsPlaying</visible>
      </control>
      <control type="image">
        <left>$PARAM[left]</left><top>$PARAM[top]</top><width>16</width><height>16</height>
        <texture>icons24/status_resume.png</texture>
        <visible>ListItem.IsResumable + !ListItem.IsPlaying</visible>
      </control>
      <control type="image">
        <left>$PARAM[left]</left><top>$PARAM[top]</top><width>16</width><height>16</height>
        <texture>icons24/status_watched.png</texture>
        <visible>Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable + !ListItem.IsPlaying</visible>
      </control>
      <control type="progress">
        <left>$PARAM[barleft]</left><top>$PARAM[bartop]</top><width>$PARAM[barwidth]</width><height>6</height>
        <info>ListItem.PercentPlayed</info>
        <visible>ListItem.IsResumable</visible>
      </control>
    </definition>
  </include>

  <!-- ========== the sunken white well a list sits in ================= -->
  <include name="Arthur_ListWell">
    <param name="width" default="634" />
    <param name="height" default="462" />
    <definition>
      <control type="image">
        <left>0</left><top>0</top>
        <width>$PARAM[width]</width><height>$PARAM[height]</height>
        <texture border="2" colordiffuse="facetint">panel_sunken.png</texture>
      </control>
    </definition>
  </include>

  <!-- ========== toolbar button, horizontal grouplist member ========== -->
  <include name="Arthur_ToolButton">
    <param name="id" default="0" />
    <param name="label" default="" />
    <param name="width" default="110" />
    <param name="onclick" default="noop" />
    <definition>
      <control type="button" id="$PARAM[id]">
        <width>$PARAM[width]</width><height>24</height>
        <font>normal</font>
        <label>$PARAM[label]</label>
        <align>center</align>
        <onclick>$PARAM[onclick]</onclick>
      </control>
    </definition>
  </include>

</includes>
