        <!-- hard 1px rule under the bar, the way Arthur draws it -->
        <control type="image">
          <left>0</left><bottom>0</bottom>
          <width>454</width><height>1</height>
          <texture>fill_black.png</texture>
        </control>

        <control type="image">
          <left>4</left><top>5</top><width>16</width><height>16</height>
          <texture>icons24/power.png</texture>
        </control>

        <!-- left + right with no width: Kodi derives the width, so the title
             stops before the window boxes instead of running underneath them -->
        <control type="label">
          <left>26</left><include content="WinTitle_Right_Mouse" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinTitle_Right_Touch" condition="Skin.HasSetting(touchmode)"/><top>0</top><height>26</height>
          <align>left</align><aligny>center</aligny>
          <font>chromebold</font><textcolor>titletext</textcolor>
