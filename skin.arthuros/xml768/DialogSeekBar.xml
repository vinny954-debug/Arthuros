<?xml version='1.0' encoding='UTF-8'?>
<window>
  <zorder>3</zorder>
  <controls>
    <control type="group">
      <centerleft>50%</centerleft><centertop>50%</centertop>
      <width>892</width><height>134</height>
      <control type="image">
        <left>0</left><top>0</top>
        <width>892</width><height>134</height>
        <texture border="2" colordiffuse="facetint">panel_raised.png</texture>
      </control>
      <control type="group">
        <left>3</left><top>3</top>
        <control type="group">
        <width>886</width><height>26</height>

        <control type="image">
          <left>0</left><top>0</top>
          <width>886</width><height>26</height>
          <texture colordiffuse="accent2">fill.png</texture>
        </control>
        <!-- hard 1px rule under the bar, the way Arthur draws it -->
        <control type="image">
          <left>0</left><bottom>0</bottom>
          <width>886</width><height>1</height>
          <texture>fill_black.png</texture>
        </control>

        <control type="image">
          <left>4</left><top>5</top><width>16</width><height>16</height>
          <texture>icons24/seek.png</texture>
        </control>

        <!-- left + right with no width: Kodi derives the width, so the title
             stops before the window boxes instead of running underneath them -->
        <control type="label">
          <left>26</left><right>100</right><top>0</top><height>26</height>
          <align>left</align><aligny>center</aligny>
          <font>chromebold</font><textcolor>titletext</textcolor>
          <label>$LOCALIZE[31907]</label>
        </control>

        <control type="label">
          <right>100</right><top>0</top><width>460</width><height>26</height>
          <align>right</align><aligny>center</aligny>
          <font>chromesmall</font><textcolor>titletext</textcolor>
          <label></label>
        </control>

        <!-- The window boxes. Which set a title bar gets is chosen by the
             "boxes" parameter: window, dialog, home or none. -->
        <control type="group"/>
      </control>
      </control>
      <control type="label">
        <left>16</left><top>38</top><width>560</width><height>26</height>
        <font>bold</font><label>$VAR[NowPlayingVar]</label>
      </control>
      <control type="slider" id="401">
        <left>16</left><top>70</top><width>860</width><height>24</height>
      </control>
      <control type="slider" id="403">
        <left>-3000</left><top>0</top><width>200</width><height>24</height>
      </control>
      <control type="label">
        <left>16</left><top>100</top><width>420</width><height>22</height>
        <font>small</font><label>$INFO[Player.SeekTime]$INFO[Player.Time]</label>
      </control>
      <control type="label">
        <left>456</left><top>100</top><width>420</width><height>22</height>
        <font>small</font><align>right</align><label>$INFO[Player.Duration]</label>
      </control>
    </control>
  </controls>
</window>