        <align>left</align><aligny>center</aligny>
        <label>Kodi $INFO[System.BuildVersionShort] - ArthurOS 1.2 (v0.9.6)</label>
      </control>

      <!-- right-hand status cluster, anchored to the right edge -->
      <control type="image">
        <right>6</right><top>5</top><width>16</width><height>16</height>
        <texture>icons24/network.png</texture>
        <visible>System.InternetState</visible>
      </control>

      <!-- The speaker and gauge are a button: a tap opens the mini player
           (PlayerControls), which has the volume slider and mute. Drawn
           under them, flat until pointed at, then pressed in like the tray.
           Its hit rect reaches down to the window frame (y 30), so a finger
           at the top edge of the screen finds it. Nothing navigates here;
           Down leaves for the task bar. With the task bar hidden, Kodi
           follows the hidden Start button's Down to the floating Back
           (Touch mode) and, when that is hidden too, on to the window's own
           list (the task bar's "up" param), so the keyboard is never stuck.
           The pressed-in look is drawn only while there is a pointer: a
           finger tap leaves focus here when the mini player closes, and
           the cluster would otherwise stay pressed in. Not on the login
           screen. -->
      <control type="image">
        <right>24</right><top>0</top><width>96</width><height>26</height>
        <texture border="2" colordiffuse="facetint">panel_sunken_chrome.png</texture>
        <visible>Control.HasFocus(9109) + !$EXP[ArthurNoPointer]</visible>
      </control>
      <control type="button" id="9109">
        <right>24</right><top>0</top><width>96</width><height>26</height>
        <hitrect x="120r" y="0" w="96" h="30"/>
        <texturenofocus>-</texturenofocus>
        <texturefocus>-</texturefocus>
        <label/>
        <ondown>9100</ondown>
        <onclick>ActivateWindow(PlayerControls)</onclick>
        <visible>!Window.IsVisible(loginscreen)</visible>
      </control>
      <control type="image">
        <right>100</right><top>5</top><width>16</width><height>16</height>
        <texture>$VAR[VolumeIconVar]</texture>
      </control>
      <!-- a small volume gauge instead of Kodi's decibel figure -->
