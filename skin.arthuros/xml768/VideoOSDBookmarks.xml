<?xml version='1.0' encoding='UTF-8'?>
<window>
  <onload>ClearProperty(arthuros.clearbm,home)</onload>
  <defaultcontrol>2</defaultcontrol>
  <controls>
    <control type="button" id="9990">
      <left>0</left><top>0</top><width>1024</width><bottom>250</bottom>
      <texturefocus/>
      <texturenofocus/>
      <label/>
      <onclick>Dialog.Close(VideoBookmarks)</onclick>
      <onup>2</onup>
      <ondown>2</ondown>
      <onleft>2</onleft>
      <onright>2</onright>
    </control>
    <control type="group">
      <centerleft>50%</centerleft><bottom>0</bottom>
      <width>1024</width><height>250</height>
      <control type="image">
        <left>0</left><top>0</top>
        <width>1024</width><height>250</height>
        <texture border="2" colordiffuse="facetint">panel_raised.png</texture>
      </control>
      <control type="group">
        <left>3</left><top>3</top>
        <control type="group">
        <width>1018</width><height>26</height>

        <control type="image">
          <left>0</left><top>0</top>
          <width>1018</width><height>26</height>
          <texture colordiffuse="accent2">fill.png</texture>
        </control>
        <!-- hard 1px rule under the bar, the way Arthur draws it -->
        <control type="image">
          <left>0</left><bottom>0</bottom>
          <width>1018</width><height>1</height>
          <texture>fill_black.png</texture>
        </control>

        <control type="image">
          <left>4</left><top>5</top><width>16</width><height>16</height>
          <texture>icons24/bookmarks.png</texture>
        </control>

        <!-- left + right with no width: Kodi derives the width, so the title
             stops before the window boxes instead of running underneath them -->
        <control type="label">
          <left>26</left><include content="WinTitle_Right_Mouse" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinTitle_Right_Touch" condition="Skin.HasSetting(touchmode)"/><top>0</top><height>26</height>
          <align>left</align><aligny>center</aligny>
          <font>chromebold</font><textcolor>titletext</textcolor>
          <label>$LOCALIZE[298]</label>
        </control>

        <control type="label">
          <include content="WinTitle_Right_Mouse" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinTitle_Right_Touch" condition="Skin.HasSetting(touchmode)"/><top>0</top><width>460</width><height>26</height>
          <align>right</align><aligny>center</aligny>
          <font>chromesmall</font><textcolor>titletext</textcolor>
          <label></label>
        </control>

        <!-- The window boxes. Which set a title bar gets is chosen by the
             "boxes" parameter: window, dialog, home or none. -->
        <control type="group"/>
      </control>
      </control>
      <control type="image">
        <left>8</left><top>34</top><width>244</width><height>208</height>
        <texture border="2" colordiffuse="facetint">panel_sunken_grey.png</texture>
      </control>
      <control type="grouplist" id="9000">
        <left>16</left><top>42</top><width>228</width><height>192</height>
        <orientation>vertical</orientation><itemgap>4</itemgap>
        <onright>11</onright>
        <control type="button" id="2">
          <width>228</width><height>44</height>
          <hitrect x="0" y="-2" w="228" h="48"/>
          <font>chrome</font><label>$LOCALIZE[294]</label>
        </control>
        <control type="button" id="4">
          <width>228</width><height>44</height>
          <hitrect x="0" y="-2" w="228" h="48"/>
          <font>chrome</font><label>$LOCALIZE[20406]</label>
          <visible>Control.IsEnabled(4)</visible>
        </control>
        <control type="button" id="9993">
          <width>228</width><height>44</height>
          <hitrect x="0" y="-2" w="228" h="48"/>
          <font>chrome</font><label>$VAR[BookmarkClearLabelVar]</label>
          <onclick condition="!String.IsEqual(Window(Home).Property(arthuros.clearbm),1)">SetProperty(arthuros.clearbm,1,home)</onclick>
          <onclick condition="String.IsEqual(Window(Home).Property(arthuros.clearbm),1)">ClearProperty(arthuros.clearbm,home)</onclick>
          <onclick condition="String.IsEqual(Window(Home).Property(arthuros.clearbm),1)">SendClick(videobookmarks,3)</onclick>
        </control>
        <control type="button" id="9994">
          <width>228</width><height>44</height>
          <hitrect x="0" y="-2" w="228" h="48"/>
          <font>chrome</font><label>$LOCALIZE[106]</label>
          <onclick>ClearProperty(arthuros.clearbm,home)</onclick>
          <onclick>SetFocus(9993)</onclick>
          <visible>String.IsEqual(Window(Home).Property(arthuros.clearbm),1)</visible>
        </control>
        <control type="button" id="9995">
          <width>228</width><height>44</height>
          <hitrect x="0" y="-2" w="228" h="48"/>
          <font>chrome</font><label>$LOCALIZE[15067]</label>
          <onclick>Dialog.Close(VideoBookmarks)</onclick>
          <visible>!String.IsEqual(Window(Home).Property(arthuros.clearbm),1)</visible>
        </control>
      </control>
      <control type="button" id="3">
        <left>-3000</left><top>0</top><width>10</width><height>10</height>
        <label/>
      </control>
      <control type="image">
        <left>260</left><top>34</top><width>756</width><height>208</height>
        <texture border="2" colordiffuse="facetint">panel_sunken.png</texture>
      </control>
      <control type="label">
        <left>276</left><top>34</top><width>724</width><height>208</height>
        <font>chrome</font><textcolor>textdim</textcolor><align>center</align><aligny>center</aligny>
        <label>$LOCALIZE[31802]</label>
        <visible>Integer.IsEqual(Container(11).NumItems,0) + !String.IsEqual(Window(Home).Property(arthuros.clearbm),1)</visible>
      </control>
      <control type="label">
        <left>276</left><top>34</top><width>724</width><height>208</height>
        <font>chromebold</font><textcolor>marked</textcolor><align>center</align><aligny>center</aligny>
        <label>$LOCALIZE[31803]</label>
        <visible>String.IsEqual(Window(Home).Property(arthuros.clearbm),1)</visible>
      </control>
      <control type="panel" id="11">
        <left>266</left><top>40</top><width>744</width><height>198</height>
        <orientation>horizontal</orientation>
        <onleft>9000</onleft><onup>9000</onup><ondown>9000</ondown>
        <visible>!String.IsEqual(Window(Home).Property(arthuros.clearbm),1)</visible>
        <itemlayout width="156" height="196">
          <control type="image">
            <left>6</left><top>6</top><width>138</width><height>132</height>
            <texture fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
            <aspectratio>keep</aspectratio>
          </control>
          <control type="label">
            <left>6</left><top>142</top><width>138</width><height>26</height>
            <font>chromebold</font><align>center</align><textcolor>text</textcolor>
            <label>$INFO[ListItem.Label]</label>
          </control>
          <control type="label">
            <left>6</left><top>168</top><width>138</width><height>22</height>
            <font>chromesmall</font><align>center</align><textcolor>textdim</textcolor>
            <label>$INFO[ListItem.Label2]</label>
          </control>
        </itemlayout>
        <focusedlayout width="156" height="196">
          <control type="image">
            <left>0</left><top>0</top><width>150</width><height>196</height>
            <texture border="2" colordiffuse="select">select_bevel.png</texture>
          </control>
          <control type="image">
            <left>6</left><top>6</top><width>138</width><height>132</height>
            <texture fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
            <aspectratio>keep</aspectratio>
          </control>
          <control type="label">
            <left>6</left><top>142</top><width>138</width><height>26</height>
            <font>chromebold</font><align>center</align><textcolor>textinv</textcolor><selectedcolor>textinv</selectedcolor>
            <label>$INFO[ListItem.Label]</label>
          </control>
          <control type="label">
            <left>6</left><top>168</top><width>138</width><height>22</height>
            <font>chromesmall</font><align>center</align><textcolor>textinv</textcolor><selectedcolor>textinv</selectedcolor>
            <label>$INFO[ListItem.Label2]</label>
          </control>
        </focusedlayout>
      </control>
    </control>
  </controls>
</window>