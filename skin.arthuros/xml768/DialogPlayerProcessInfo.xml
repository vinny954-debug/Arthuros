<?xml version='1.0' encoding='UTF-8'?>
<window>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1024</width><height>768</height>
      <texture>dim.png</texture>
    </control>
    <control type="group">
      <right>4</right><top>736</top><width>116</width><height>32</height>
      <visible>Skin.HasSetting(touchmode)</visible>
      <control type="image">
        <left>0</left><top>0</top><width>116</width><height>32</height>
        <texture border="2" colordiffuse="facetint">panel_chrome.png</texture>
      </control>
      <control type="button" id="9108">
        <left>0</left><top>0</top><width>116</width><height>32</height>
        <hitrect x="-2" y="0" w="122" h="32"/>
        <label/>
        <onup>9903</onup><onleft>9903</onleft>
        <onclick>Action(Back)</onclick>
      </control>
      <control type="image">
        <left>8</left><top>8</top><width>16</width><height>16</height>
        <texture>icons24/parent.png</texture>
      </control>
      <control type="label">
        <left>30</left><top>0</top><width>80</width><height>32</height>
        <font>chromebold</font><textcolor>text</textcolor><aligny>center</aligny>
        <label>$LOCALIZE[31994]</label>
        <visible>!Control.HasFocus(9108)</visible>
      </control>
      <control type="label">
        <left>30</left><top>0</top><width>80</width><height>32</height>
        <font>chromebold</font><textcolor>textinv</textcolor><aligny>center</aligny>
        <label>$LOCALIZE[31994]</label>
        <visible>Control.HasFocus(9108)</visible>
      </control>
    </control>
    <control type="group">
      <centerleft>50%</centerleft><centertop>50%</centertop>
      <width>900</width><height>500</height>
      <control type="image">
        <left>0</left><top>0</top>
        <width>900</width><height>500</height>
        <texture border="2" colordiffuse="facetint">panel_raised.png</texture>
      </control>
      <control type="group">
        <left>3</left><top>3</top>
        <control type="group">
        <width>894</width><height>26</height>

        <control type="image">
          <left>0</left><top>0</top>
          <width>894</width><height>26</height>
          <texture colordiffuse="accent2">fill.png</texture>
        </control>
        <!-- hard 1px rule under the bar, the way Arthur draws it -->
        <control type="image">
          <left>0</left><bottom>0</bottom>
          <width>894</width><height>1</height>
          <texture>fill_black.png</texture>
        </control>

        <control type="image">
          <left>4</left><top>5</top><width>16</width><height>16</height>
          <texture>icons24/process_info.png</texture>
        </control>

        <!-- left + right with no width: Kodi derives the width, so the title
             stops before the window boxes instead of running underneath them -->
        <control type="label">
          <left>26</left><include content="WinTitle_Right_Mouse" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinTitle_Right_Touch" condition="Skin.HasSetting(touchmode)"/><top>0</top><height>26</height>
          <align>left</align><aligny>center</aligny>
          <font>chromebold</font><textcolor>titletext</textcolor>
          <label></label>
        </control>

        <control type="label">
          <include content="WinTitle_Right_Mouse" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinTitle_Right_Touch" condition="Skin.HasSetting(touchmode)"/><top>0</top><width>460</width><height>26</height>
          <align>right</align><aligny>center</aligny>
          <font>chromesmall</font><textcolor>titletext</textcolor>
          <label></label>
        </control>

        <!-- The window boxes. Which set a title bar gets is chosen by the
             "boxes" parameter: window, dialog, home or none. -->
        <control type="group">
      <control type="button" id="9901">
        <include content="WinBox_1" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinBox_1_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texturenofocus border="4" colordiffuse="facetint">wc_face.png</texturenofocus>
        <texturefocus border="2" colordiffuse="select">select_bevel.png</texturefocus>
        <label/>
        <onclick>Dialog.Close(all,true)</onclick>
        <onclick>ActivateWindow(Home)</onclick>
        <onright>9902</onright>
        <ondown></ondown>
      </control>
      <control type="image">
        <include content="WinBox_1" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinGlyph_1_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texture colordiffuse="text">wc_min_g.png</texture>
        <visible>!Control.HasFocus(9901)</visible>
      </control>
      <control type="image">
        <include content="WinBox_1" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinGlyph_1_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texture colordiffuse="titletext">wc_min_g.png</texture>
        <visible>Control.HasFocus(9901)</visible>
      </control>
      <control type="button" id="9902">
        <include content="WinBox_2" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinBox_2_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texturenofocus border="4" colordiffuse="facetint">wc_face.png</texturenofocus>
        <texturefocus border="2" colordiffuse="select">select_bevel.png</texturefocus>
        <label/>
        <enable>$EXP[ArthurCanShowPlayer]</enable>
        <onclick condition="true">Dialog.Close(all,true)</onclick>
        <onclick>Action(FullScreen)</onclick>
        <onleft>9901</onleft>
        <onright>9903</onright>
        <ondown></ondown>
      </control>
      <control type="image">
        <include content="WinBox_2" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinGlyph_2_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texture colordiffuse="text">wc_max_g.png</texture>
        <visible>!Control.HasFocus(9902) + $EXP[ArthurCanShowPlayer]</visible>
      </control>
      <control type="image">
        <include content="WinBox_2" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinGlyph_2_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texture colordiffuse="titletext">wc_max_g.png</texture>
        <visible>Control.HasFocus(9902)</visible>
      </control>
      <control type="image">
        <include content="WinBox_2" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinGlyph_2_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texture colordiffuse="textdim">wc_max_dg.png</texture>
        <visible>!$EXP[ArthurCanShowPlayer]</visible>
      </control>
      <control type="button" id="9903">
        <include content="WinBox_3" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinBox_3_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texturenofocus border="4" colordiffuse="facetint">wc_face.png</texturenofocus>
        <texturefocus border="2" colordiffuse="select">select_bevel.png</texturefocus>
        <label/>
        <onclick>Action(Back)</onclick>
        <onleft>9902</onleft>
        <ondown></ondown>
      </control>
      <control type="image">
        <include content="WinBox_3" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinGlyph_3_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texture colordiffuse="text">wc_close_g.png</texture>
        <visible>!Control.HasFocus(9903)</visible>
      </control>
      <control type="image">
        <include content="WinBox_3" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinGlyph_3_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texture colordiffuse="titletext">wc_close_g.png</texture>
        <visible>Control.HasFocus(9903)</visible>
      </control>
    </control>
      </control>
      </control>
      <control type="label" id="1">
        <left>29</left><top>3</top><height>26</height>
        <include content="Dialog_Heading_Width" condition="!Skin.HasSetting(touchmode)"><param name="width" value="794"/></include>
        <include content="Dialog_Heading_Touch" condition="Skin.HasSetting(touchmode)"/>
        <font>chromebold</font><textcolor>titletext</textcolor>
        <align>left</align><aligny>center</aligny>
      </control>
    </control>
  </controls>
</window>