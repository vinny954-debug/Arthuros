      </control>
      <control type="image">
        <include content="WinBox_2" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinGlyph_2_Touch" condition="Skin.HasSetting(touchmode)"/>
        <texture colordiffuse="titletext">wc_max_g.png</texture>
        <visible>Control.HasFocus(9902)</visible>
      </control>
      <control type="image">
        <include content="WinBox_2" condition="!Skin.HasSetting(touchmode)"/>
      <include content="WinGlyph_2_Touch" condition="Skin.HasSetting(touchmode)"/>
