<?xml version="1.0" encoding="UTF-8"?>
<!-- ===================================================================
     The media browser window. Every library and file window is this
     template with a different title and icon, so behaviour stays
     identical wherever you are.

     Control ids 2, 3, 4 and 19 are fixed by Kodi (view / sort by /
     sort order / filter) and must keep those numbers.
     Geometry is relative to a group placed at 6,30 sized 1012x534.

     Windows with buttons of their own (play queue, libraries, pictures,
     Live TV) use Media_Window_Extras: a second toolbar row (grouplist
     9491, left column only) carries the ids that window's C++ acts on,
     and the views start 36 px lower. The ids differ per window (20 is
     Shuffle in the playlist but Update library in the libraries), so
     each window has its own Media_Extras_* include.

     Hit areas (for a finger): every toolbar button is drawn 26 px high
     but its <hitrect> covers 34 px (frame y 30-64, the gap under the
     title bar down to the second row) plus half of each 4 px gap; every
     second-row button is drawn 34 px and hits 36 px (64-100, down to
     the views at 102). A hitrect is in the button's own slot
     coordinates inside the grouplist (GUIControlFactory::GetHitRect,
     CGUIControlGroupList::SendMouseEvent), so nothing moves and the
     same numbers hold in xml768. When you change a button's width,
     change its hitrect w (= width + 4) with it.
     =================================================================== -->
<includes>

  <!-- ===== variables used by the browsers and the info dialogs ======= -->
  <!-- the item count; Kodi writes "N Objects" into any control id 12, so
       this label has no id and stays live -->
  <variable name="MediaCountVar">
    <value condition="Integer.IsGreater(Container.NumItems,0)">$INFO[Container.NumItems] $LOCALIZE[127]</value>
    <value />
  </variable>
  <!-- title-bar right-hand text: inside an add-on the folder path is a
       plugin:// address, so show the item count there instead (the
       toolbar has no room for it next to Add-on settings) -->
  <variable name="MediaTitle2Var">
    <value condition="!String.IsEmpty(Container.PluginName)">$VAR[MediaCountVar]</value>
    <value>$INFO[Container.FolderPath]</value>
  </variable>
  <!-- Live TV channels / recordings: Kodi's header labels (hidden
       labels 29 and 30 in the second row) - the group name or "Hidden",
       "Deleted" in the recordings trash, the recordings folder -->
  <variable name="Media_PVRTitle2Var">
    <value condition="!String.IsEmpty(Control.GetLabel(29)) + !String.IsEmpty(Control.GetLabel(30))">$INFO[Control.GetLabel(29)]  -  $INFO[Control.GetLabel(30)]</value>
    <value>$INFO[Control.GetLabel(29)]$INFO[Control.GetLabel(30)]</value>
  </variable>
  <!-- poster wall art: posters first, then Kodi's own icon chain
       (thumb, then the DefaultVideo/DefaultFolder... icon Kodi sets) -->
  <variable name="PosterArtVar">
    <value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
    <value>$INFO[ListItem.Icon]</value>
  </variable>
  <variable name="VideoInfoArtVar">
    <value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
    <value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(season.poster))">$INFO[ListItem.Art(season.poster)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
    <value>$INFO[ListItem.Icon]</value>
  </variable>
  <variable name="MusicInfoArtVar">
    <value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
    <value condition="String.IsEqual(ListItem.DBType,artist)">DefaultArtist.png</value>
    <value condition="String.IsEqual(ListItem.DBType,album)">DefaultAlbumCover.png</value>
    <value>DefaultAudio.png</value>
  </variable>
  <!-- Play on a TV show, season or set opens its episodes / films -->
  <variable name="InfoPlayLabelVar">
    <value condition="String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,set)">$LOCALIZE[1024]</value>
    <value>$LOCALIZE[208]</value>
  </variable>
  <!-- button 20 starts a scan, or stops the one running -->
  <variable name="VideoScanLabelVar">
    <value condition="Library.IsScanningVideo">$LOCALIZE[13353]</value>
    <value>$LOCALIZE[653]</value>
  </variable>
  <variable name="MusicScanLabelVar">
    <value condition="Library.IsScanningMusic">$LOCALIZE[13353]</value>
    <value>$LOCALIZE[653]</value>
  </variable>

  <!-- Ascending / Descending; "Order" where the list has no sort order -->
  <variable name="MediaSortOrderVar">
    <value condition="!String.IsEmpty(Container.SortOrder)">$INFO[Container.SortOrder]</value>
    <value>$LOCALIZE[31904]</value>
  </variable>

  <!-- scrollbar beside a long text: wider for a finger -->
  <include name="Media_SBWidth"><width>24</width></include>
  <include name="Media_SBWidth_XL"><width>30</width></include>

  <include name="Media_Toolbar">
    <param name="down" default="50" />
    <definition>
    <control type="grouplist" id="9490">
      <left>6</left><top>34</top><width>1000</width><height>26</height>
      <orientation>horizontal</orientation>
      <itemgap>4</itemgap>
      <align>left</align>
      <onup>9100</onup>
      <ondown>$PARAM[down]</ondown>

      <control type="button" id="9500">
        <width>76</width><height>26</height><include content="Size_Hit" condition="Skin.HasSetting(touchmode)"><param name="x" value="-2" /><param name="y" value="-4" /><param name="w" value="80" /><param name="h" value="34" /></include><font>chrome</font>
        <label>$LOCALIZE[31901]</label>
        <onclick>ParentDir</onclick>
      </control>
      <control type="button" id="2">
        <width>150</width><height>26</height><include content="Size_Hit" condition="Skin.HasSetting(touchmode)"><param name="x" value="-2" /><param name="y" value="-4" /><param name="w" value="154" /><param name="h" value="34" /></include><font>chrome</font>
        <label>$LOCALIZE[31902]</label>
      </control>
      <control type="button" id="3">
        <width>230</width><height>26</height><include content="Size_Hit" condition="Skin.HasSetting(touchmode)"><param name="x" value="-2" /><param name="y" value="-4" /><param name="w" value="234" /><param name="h" value="34" /></include><font>chrome</font>
        <label>$LOCALIZE[31903]</label>
      </control>
      <!-- Kodi only marks this button selected when descending and never
           labels it, so the label says which way the list is sorted -->
      <control type="button" id="4">
        <width>120</width><height>26</height><include content="Size_Hit" condition="Skin.HasSetting(touchmode)"><param name="x" value="-2" /><param name="y" value="-4" /><param name="w" value="124" /><param name="h" value="34" /></include><font>chrome</font>
        <label>$VAR[MediaSortOrderVar]</label>
      </control>
      <control type="button" id="19">
        <width>100</width><height>26</height><include content="Size_Hit" condition="Skin.HasSetting(touchmode)"><param name="x" value="-2" /><param name="y" value="-4" /><param name="w" value="104" /><param name="h" value="34" /></include><font>chrome</font>
        <label>$LOCALIZE[587]</label>
      </control>
      <!-- Action(ContextMenu) goes to the focused control, which is this
           button; focus the view first (Kodi redirects 50 to whichever
           view is showing) so the menu is the selected item's -->
      <control type="button" id="9501">
        <width>110</width><height>26</height><include content="Size_Hit" condition="Skin.HasSetting(touchmode)"><param name="x" value="-2" /><param name="y" value="-4" /><param name="w" value="114" /><param name="h" value="34" /></include><font>chrome</font>
        <label>$LOCALIZE[31906]</label>
        <onclick>SetFocus(50)</onclick>
        <onclick>Action(ContextMenu)</onclick>
      </control>
      <!-- inside an add-on (YouTube, Plex...): its own settings - quality,
           sign-in, subtitles - one click away instead of only in Options -->
      <control type="button" id="9502">
        <width>180</width><height>26</height><include content="Size_Hit" condition="Skin.HasSetting(touchmode)"><param name="x" value="-2" /><param name="y" value="-4" /><param name="w" value="184" /><param name="h" value="34" /></include><font>chrome</font>
        <label>$LOCALIZE[10140]</label>
        <onclick>Addon.OpenSettings($INFO[Container.PluginName])</onclick>
        <visible>!String.IsEmpty(Container.PluginName)</visible>
      </control>
    </control>

    <!-- item count, right hand end of the toolbar strip (in an add-on it
         moves to the title bar, see MediaTitle2Var) -->
    <control type="label">
      <left>816</left><top>34</top><width>190</width><height>26</height>
      <font>small</font><textcolor>textdim</textcolor>
      <align>right</align><aligny>center</aligny>
      <label>$VAR[MediaCountVar]</label>
      <visible>String.IsEmpty(Container.PluginName)</visible>
    </control>
    </definition>
  </include>

