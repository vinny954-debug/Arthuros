    <control type="button" id="9503">
      <width>154</width><height>34</height><font>chrome</font>
      <hitrect x="-2" y="0" w="158" h="36" />
      <label>$LOCALIZE[184]</label>
      <onclick>Container.Refresh</onclick>
      <visible>!String.IsEmpty(Container.PluginName)</visible>
    </control>
    <control type="button" id="9504">
      <width>200</width><height>34</height><font>chrome</font>
      <hitrect x="-2" y="0" w="204" h="36" />
      <label>$LOCALIZE[31875]</label>
      <onclick>Container.Update(plugin://$INFO[Container.PluginName]/)</onclick>
      <visible>!String.IsEmpty(Container.PluginName)</visible>
    </control>
  </include>

  <!-- music library: GUIWindowMusicNav.cpp 8 search, 16 party mode,
