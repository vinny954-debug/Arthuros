    <control type="button" id="6">
      <width>216</width><height>34</height><font>chrome</font>
      <hitrect x="-2" y="0" w="220" h="36" />
      <label>$LOCALIZE[13317]</label>
    </control>
    <control type="button" id="7">
      <width>216</width><height>34</height><font>chrome</font>
      <hitrect x="-2" y="0" w="220" h="36" />
