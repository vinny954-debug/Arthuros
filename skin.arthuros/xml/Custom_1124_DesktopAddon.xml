  <onload condition="!String.IsEmpty(Skin.String(pick.addon)) + [String.StartsWith(Skin.String(pick.addon),plugin.image.)] + ![String.Contains(Skin.String(pick.addon),plex) | String.Contains(Skin.String(pick.addon),jellyfin) | String.Contains(Skin.String(pick.addon),emby)] + ![String.Contains(Skin.String(pick.addon),game) | String.Contains(Skin.String(pick.addon),iagl) | String.Contains(Skin.String(pick.addon),retro) | String.Contains(Skin.String(pick.addon),emulat)] + ![String.Contains(Skin.String(pick.addon),libreelec) | String.Contains(Skin.String(pick.addon),settings) | String.Contains(Skin.String(pick.addon),service.)] + ![String.StartsWith(Skin.String(pick.addon),plugin.audio.)] + ![String.StartsWith(Skin.String(pick.addon),plugin.video.)]">Skin.SetString(tile.$INFO[Skin.String(edit.slot)].icon,addons_pictures)</onload>
  <onload condition="!String.IsEmpty(Skin.String(pick.addon)) + ![String.Contains(Skin.String(pick.addon),plex) | String.Contains(Skin.String(pick.addon),jellyfin) | String.Contains(Skin.String(pick.addon),emby)] + ![String.Contains(Skin.String(pick.addon),game) | String.Contains(Skin.String(pick.addon),iagl) | String.Contains(Skin.String(pick.addon),retro) | String.Contains(Skin.String(pick.addon),emulat)] + ![String.Contains(Skin.String(pick.addon),libreelec) | String.Contains(Skin.String(pick.addon),settings) | String.Contains(Skin.String(pick.addon),service.)] + ![String.StartsWith(Skin.String(pick.addon),plugin.audio.)] + ![String.StartsWith(Skin.String(pick.addon),plugin.video.)] + ![String.StartsWith(Skin.String(pick.addon),plugin.image.)]">Skin.SetString(tile.$INFO[Skin.String(edit.slot)].icon,addons_program)</onload>
