<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1124">
  <!-- no controls to show: it only applies the add-on picked in 1122 -->
  <onload condition="!String.IsEmpty(Skin.String(pick.addon))">Skin.SetString(tile.$INFO[Skin.String(edit.slot)].name,$ESCINFO[System.AddonTitle(Skin.String(pick.addon))])</onload>
  <onload condition="!String.IsEmpty(Skin.String(pick.addon))">Skin.SetString(tile.$INFO[Skin.String(edit.slot)].addon,$ESCINFO[Skin.String(pick.addon)])</onload>
  <onload condition="!String.IsEmpty(Skin.String(pick.addon))">Skin.SetString(tile.$INFO[Skin.String(edit.slot)].action,"RunAddon($INFO[Skin.String(pick.addon)])")</onload>
  <onload condition="!String.IsEmpty(Skin.String(pick.addon))">Skin.Reset(tile.$INFO[Skin.String(edit.slot)].id)</onload>
  <onload condition="!String.IsEmpty(Skin.String(pick.addon))">Skin.Reset(tile.$INFO[Skin.String(edit.slot)].lid)</onload>
  <onload condition="!String.IsEmpty(Skin.String(pick.addon))">Skin.Reset(tile.$INFO[Skin.String(edit.slot)].pre)</onload>
