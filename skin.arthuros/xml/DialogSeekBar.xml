      </control>
      <control type="slider" id="403">
        <left>238</left><top>8</top><width>674</width><height>28</height>
        <orientation>horizontal</orientation>
        <visible>VideoPlayer.Content(LiveTV)</visible>
      </control>
      <control type="label">
        <left>920</left><top>0</top><width>96</width><height>44</height>
        <font>chrome</font><aligny>center</aligny>
        <label>$INFO[Player.Duration]</label>
      </control>
    </control>
  </controls>
</window>
