<?xml version="1.0" encoding="UTF-8"?>
<!-- Serves YesNo, OK, Progress and Custom. Ids 1/2/3/4/9/10/11/12/20 are Kodi's. -->
<window>
  <defaultcontrol>11</defaultcontrol>
  <controls>
    <include>Dialog_Dim</include>
    <control type="group">
      <centerleft>50%</centerleft><centertop>50%</centertop>
      <width>580</width><height>300</height>

      <include content="Dialog_Box">
        <param name="width" value="580" />
        <param name="height" value="300" />
        <param name="innerwidth" value="574" />
        <param name="icon" value="icons24/info.png" />
      </include>

      <include content="Dialog_Heading"><param name="width" value="460" /></include>

      <control type="image">
        <left>10</left><top>36</top><width>560</width><height>186</height>
        <texture border="2" colordiffuse="facetint">panel_sunken.png</texture>
      </control>

      <control type="label" id="2">
        <left>20</left><top>48</top><width>540</width><height>24</height>
        <align>center</align><font>bold</font>
      </control>
      <control type="label" id="3">
        <left>20</left><top>74</top><width>540</width><height>24</height>
        <align>center</align>
      </control>
      <control type="label" id="4">
        <left>20</left><top>100</top><width>540</width><height>24</height>
        <align>center</align>
      </control>
      <!-- Long messages scroll by themselves (as in Estuary) and can be
           dragged by the scrollbar, which only shows when there is more
           text than fits. Touching the bar stops the auto-scroll. -->
      <control type="textbox" id="9">
        <left>20</left><top>48</top><include content="Size_Width" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="506" /></include><include content="Size_Width" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="518" /></include><height>132</height>
        <align>center</align>
        <pagecontrol>61</pagecontrol>
        <autoscroll time="3000" delay="4000" repeat="5000">!Control.HasFocus(61)</autoscroll>
      </control>
      <control type="scrollbar" id="61">
        <include content="Size_Left" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="530" /></include><include content="Size_Left" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="542" /></include><top>48</top><include content="Size_Width" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="30" /></include><include content="Size_Width" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="18" /></include><height>132</height>
        <showonepage>false</showonepage>
        <onleft>11</onleft><onright>11</onright><ondown>11</ondown>
      </control>
      <control type="progress" id="20">
        <left>20</left><top>190</top><width>540</width><height>20</height>
      </control>

      <control type="group">
        <left>13</left>
        <include content="ConfirmRow_Top_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
        <include content="ConfirmRow_Top" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
        <include content="Dialog_ButtonRow"><param name="width" value="554" /></include>
      </control>
    </control>
  </controls>
</window>
