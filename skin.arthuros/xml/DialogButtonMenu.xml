<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol>9000</defaultcontrol>
  <controls>
    <include>Dialog_Dim</include>
    <control type="group">
      <centerleft>50%</centerleft><centertop>50%</centertop>
      <width>460</width><height>456</height>
      <include content="Dialog_Box">
        <param name="width" value="460" /><param name="height" value="456" />
        <param name="innerwidth" value="454" />
        <param name="icon" value="icons24/power.png" /><param name="colour" value="accent1" />
        <param name="down" value="9000" />
        <param name="boxes" value="none" />
        <param name="title" value="$LOCALIZE[31976]" />
      </include>
      <control type="image">
        <left>10</left><top>36</top><width>440</width><height>408</height>
        <texture border="2" colordiffuse="facetint">panel_sunken.png</texture>
      </control>
      <control type="list" id="9000">
        <left>16</left><top>42</top><width>404</width><height>396</height>
        <onleft>9000</onleft><onright>9000</onright>
        <onup>9000</onup><ondown>9000</ondown>
        <scrolltime tween="linear">0</scrolltime>
        <itemlayout height="50" width="404" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]">
          <control type="image">
            <left>6</left><top>17</top><width>16</width><height>16</height>
            <texture>$INFO[ListItem.Icon]</texture>
          </control>
          <control type="label">
            <left>30</left><top>0</top><width>368</width><height>50</height>
            <font>normal</font><textcolor>text</textcolor><aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
          </control>
        </itemlayout>
        <focusedlayout height="50" width="404" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]">
          <control type="image">
            <left>0</left><top>0</top><width>404</width><height>50</height>
            <texture colordiffuse="accent1">fill.png</texture>
          </control>
          <control type="image">
            <left>6</left><top>17</top><width>16</width><height>16</height>
            <texture>$INFO[ListItem.Icon]</texture>
          </control>
          <control type="label">
            <left>30</left><top>0</top><width>368</width><height>50</height>
            <font>bold</font><textcolor>textinv</textcolor><aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
          </control>
        </focusedlayout>
        <itemlayout height="34" width="404">
          <control type="image">
            <left>6</left><top>9</top><width>16</width><height>16</height>
            <texture>$INFO[ListItem.Icon]</texture>
          </control>
          <control type="label">
            <left>30</left><top>0</top><width>368</width><height>34</height>
            <font>normal</font><textcolor>text</textcolor><aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
          </control>
        </itemlayout>
        <focusedlayout height="34" width="404">
          <control type="image">
            <left>0</left><top>0</top><width>404</width><height>34</height>
            <texture colordiffuse="accent1">fill.png</texture>
          </control>
          <control type="image">
            <left>6</left><top>9</top><width>16</width><height>16</height>
            <texture>$INFO[ListItem.Icon]</texture>
          </control>
          <control type="label">
            <left>30</left><top>0</top><width>368</width><height>34</height>
            <font>bold</font><textcolor>textinv</textcolor><aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
          </control>
        </focusedlayout>
        <content>
          <item>
            <label>$LOCALIZE[13016]</label>
            <icon>icons24/power.png</icon>
            <onclick>Powerdown()</onclick>
            <visible>System.CanPowerDown</visible>
          </item>
          <item>
            <label>$LOCALIZE[13011]</label>
            <icon>icons24/power_suspend.png</icon>
            <onclick>Dialog.Close(shutdownmenu)</onclick><onclick>Suspend()</onclick>
            <visible>System.CanSuspend</visible>
          </item>
          <item>
            <label>$LOCALIZE[13010]</label>
            <icon>icons24/power_hibernate.png</icon>
            <onclick>Dialog.Close(shutdownmenu)</onclick><onclick>Hibernate()</onclick>
            <visible>System.CanHibernate</visible>
          </item>
          <item>
            <label>$LOCALIZE[13013]</label>
            <icon>icons24/power_reboot.png</icon>
            <onclick>Reset()</onclick>
            <visible>System.CanReboot</visible>
          </item>
          <item>
            <label>$LOCALIZE[13012]</label>
            <icon>icons24/exit.png</icon>
            <onclick>Quit()</onclick>
            <visible>System.ShowExitButton</visible>
          </item>
          <item>
            <label>$LOCALIZE[20150]</label>
            <icon>icons24/clock.png</icon>
            <onclick>AlarmClock(shutdowntimer,Shutdown())</onclick>
            <visible>!System.HasAlarm(shutdowntimer)</visible>
          </item>
          <item>
            <label>$LOCALIZE[20151]</label>
            <icon>icons24/timer_cancel.png</icon>
            <onclick>CancelAlarm(shutdowntimer)</onclick>
            <visible>System.HasAlarm(shutdowntimer)</visible>
          </item>
          <item>
            <label>$LOCALIZE[13017]</label>
            <icon>icons24/power_inhibit.png</icon>
            <onclick>InhibitIdleShutdown(true)</onclick>
            <visible>System.HasShutdown + !System.IdleShutdownInhibited</visible>
          </item>
          <item>
            <label>$LOCALIZE[13018]</label>
            <icon>icons24/power_allow.png</icon>
            <onclick>InhibitIdleShutdown(false)</onclick>
            <visible>System.HasShutdown + System.IdleShutdownInhibited</visible>
          </item>
          <item>
            <label>$LOCALIZE[20126]</label>
            <icon>icons24/logoff.png</icon>
            <onclick>Dialog.Close(all,true)</onclick><onclick>System.LogOff</onclick>
            <visible>System.HasLoginScreen</visible>
          </item>
          <item>
            <label>$LOCALIZE[20045]</label>
            <icon>icons24/masterlock.png</icon>
            <onclick>mastermode</onclick>
            <visible>System.HasLocks + !System.IsMaster</visible>
          </item>
          <item>
            <label>$LOCALIZE[20046]</label>
            <icon>icons24/masterlock_off.png</icon>
            <onclick>mastermode</onclick>
            <visible>System.HasLocks + System.IsMaster</visible>
          </item>
        </content>
      </control>
      <!-- the dialog boxes, login-safe (LOGIN_SAFE) -->
      <control type="group">
        <left>3</left><top>3</top><width>454</width><height>26</height>
        <control type="group">
          <control type="image">
            <include content="WinBox">
              <param name="n" value="1" />
            </include>
            <texture colordiffuse="facetint">wc_face.png</texture>
            <visible>Window.IsVisible(loginscreen)</visible>
          </control>
          <control type="image">
            <include content="WinBox">
              <param name="n" value="1" />
            </include>
            <texture colordiffuse="textdim">wc_min_dg.png</texture>
            <visible>Window.IsVisible(loginscreen)</visible>
          </control>
          <control type="image">
            <include content="WinBox">
              <param name="n" value="1" />
            </include>
            <texture border="4" colordiffuse="facetint">wc_face.png</texture>
            <visible>Window.IsVisible(loginscreen)</visible>
          </control>
          <control type="image">
            <include content="WinGlyph">
              <param name="n" value="1" />
            </include>
            <texture colordiffuse="textdim">wc_min_dg.png</texture>
            <visible>Window.IsVisible(loginscreen)</visible>
          </control>
          <control type="button" id="9901">
            <include content="WinBox">
              <param name="n" value="1" />
            </include>
            <texturenofocus border="4" colordiffuse="facetint">wc_face.png</texturenofocus>
            <texturefocus border="2" colordiffuse="select">select_bevel.png</texturefocus>
            <label />
            <onclick>Dialog.Close(all,true)</onclick>
            <onclick condition="!Window.IsVisible(loginscreen) + [!Window.IsVisible(loginscreen)]">ActivateWindow(Home)</onclick>
            <onright>9902</onright>
            <ondown>9000</ondown>
            <visible>!Window.IsVisible(loginscreen)</visible>
            <visible>!Window.IsVisible(loginscreen)</visible>
          </control>
          <control type="image">
            <include content="WinGlyph">
              <param name="n" value="1" />
            </include>
            <texture colordiffuse="text">wc_min_g.png</texture>
            <visible>!Control.HasFocus(9901) + !Window.IsVisible(loginscreen) + !Window.IsVisible(loginscreen)</visible>
          </control>
          <control type="image">
            <include content="WinGlyph">
              <param name="n" value="1" />
            </include>
            <texture colordiffuse="titletext">wc_min_g.png</texture>
            <visible>Control.HasFocus(9901) + !Window.IsVisible(loginscreen) + !Window.IsVisible(loginscreen)</visible>
          </control>
          <include content="WinBox_Max">
            <param name="down" value="$PARAM[down]" />
            <param name="close" value="true" />
          </include>
          <control type="button" id="9903">
            <include content="WinBox">
              <param name="n" value="3" />
            </include>
            <texturenofocus border="4" colordiffuse="facetint">wc_face.png</texturenofocus>
            <texturefocus border="2" colordiffuse="select">select_bevel.png</texturefocus>
            <label />
            <onclick>Action(Back)</onclick>
            <onleft>9902</onleft>
            <ondown>9000</ondown>
          </control>
          <control type="image">
            <include content="WinGlyph">
              <param name="n" value="3" />
            </include>
            <texture colordiffuse="text">wc_close_g.png</texture>
            <visible>!Control.HasFocus(9903)</visible>
          </control>
          <control type="image">
            <include content="WinGlyph">
              <param name="n" value="3" />
            </include>
            <texture colordiffuse="titletext">wc_close_g.png</texture>
            <visible>Control.HasFocus(9903)</visible>
          </control>
        </control>
      </control>
    </control>
  </controls>
</window>
