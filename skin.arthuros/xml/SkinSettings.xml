<?xml version="1.0" encoding="UTF-8"?>
<!-- The skin's own options. Kodi does not populate this window; everything
     here is ours, driven by Skin.ToggleSetting / Skin.HasSetting. -->
<window>
  <defaultcontrol always="false">100</defaultcontrol>
  <backgroundcolor>desktop</backgroundcolor>
  <controls>
    <include>Chrome_Desktop</include>
    <include>Chrome_Menubar</include>

    <control type="group">
      <left>6</left><top>30</top><width>1012</width><height>534</height>
      <include content="Win_Frame">
        <param name="width" value="1012" /><param name="height" value="534" />
      </include>
      <control type="group">
        <left>3</left><top>3</top>
        <include content="Win_Title">
          <param name="width" value="1006" />
          <param name="colour" value="accent1" />
          <param name="icon" value="icons24/skin.png" />
          <param name="label" value="$LOCALIZE[20077]" />
          <param name="down" value="100" />
          <param name="boxes" value="window" />
        </include>
      </control>

      <control type="image">
        <left>6</left><top>34</top><width>1000</width><height>494</height>
        <texture border="2" colordiffuse="facetint">panel_sunken_grey.png</texture>
      </control>

      <control type="label">
        <left>20</left><top>44</top><width>960</width><height>26</height>
        <font>bigbold</font>
        <label>ArthurOS 1.2</label>
      </control>
      <control type="label">
        <left>20</left><top>72</top><width>960</width><height>22</height>
        <font>small</font><textcolor>textdim</textcolor>
        <label>v0.9.8  -  1024x600  -  $VAR[SkinFontVar]  -  $LOCALIZE[31948]</label>
      </control>
      <control type="image">
        <left>20</left><top>102</top><width>960</width><height>1</height>
        <texture>fill_black.png</texture>
      </control>

      <!-- 15 rows: 532 px normally, 820 in Touch mode (with the task-bar
           hint 115), against 396; the scrollbar (98) shows there is more
           and can be dragged by touch (30 px wide with taller rows) -->
      <control type="grouplist" id="99">
        <left>20</left><top>116</top><width>530</width><height>396</height>
        <orientation>vertical</orientation><itemgap>4</itemgap>
        <onup>9100</onup><ondown>9100</ondown><onright>98</onright>
        <pagecontrol>98</pagecontrol>

        <control type="radiobutton" id="100">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31919]</label>
          <onclick>Skin.ToggleSetting(hidemenubar)</onclick>
          <selected>Skin.HasSetting(hidemenubar)</selected>
        </control>
        <control type="radiobutton" id="101">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31920]</label>
          <onclick>Skin.ToggleSetting(hidetaskbar)</onclick>
          <selected>Skin.HasSetting(hidetaskbar)</selected>
        </control>
        <!-- Touch mode: a hidden task bar still leaves a Back button at the
             bottom right (Chrome_Taskbar 9107). Not focusable, but it needs
             an id so the grouplist's Up/Down chain passes over it -->
        <control type="label" id="115">
          <width>530</width><include content="Height_28_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_28" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <font>small</font><textcolor>textdim</textcolor><textoffsetx>24</textoffsetx>
          <aligny>center</aligny>
          <label>$LOCALIZE[31872]</label>
          <visible>Skin.HasSetting(touchmode)</visible>
        </control>
        <control type="radiobutton" id="102">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31921]</label>
          <onclick>Skin.ToggleSetting(hideclock)</onclick>
          <selected>Skin.HasSetting(hideclock)</selected>
        </control>
        <!-- autoscroll is read by the textbox default in Defaults.xml and by
             every long description that sets its own <autoscroll> (plots in
             the info dialogs, the browser info panel, add-on info, System
             information: "Skin.HasSetting(autoscroll) + ..."). Only a
             confirmation message (DialogConfirm) and this page's help
             scroll regardless: they must be readable whatever the setting.
             List labels never scroll. -->
        <control type="radiobutton" id="103">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31910]</label>
          <onclick>Skin.ToggleSetting(autoscroll)</onclick>
          <selected>Skin.HasSetting(autoscroll)</selected>
        </control>
        <control type="radiobutton" id="113">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31995]</label>
          <onclick>Skin.ToggleSetting(touchmode)</onclick>
          <onclick condition="!Skin.HasSetting(touchmode)">RunScript(special://skin/scripts/mousewatch.py)</onclick>
          <onclick>ReloadSkin()</onclick>
          <selected>Skin.HasSetting(touchmode)</selected>
        </control>
        <!-- a heading, but it still needs an id: the grouplist chains Up/Down
             by id, and an id-less child stops the keyboard here -->
        <control type="label" id="105">
          <width>530</width><include content="Height_28_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_28" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <font>bold</font><label>$LOCALIZE[31924]</label>
        </control>
        <control type="radiobutton" id="106">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31925]</label>
          <onclick>Skin.Reset(pointer)</onclick>
          <selected>String.IsEmpty(Skin.String(pointer))</selected>
        </control>
        <control type="radiobutton" id="107">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31926]</label>
          <onclick>Skin.SetString(pointer,classic)</onclick>
          <selected>String.IsEqual(Skin.String(pointer),classic)</selected>
        </control>
        <control type="radiobutton" id="108">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31927]</label>
          <onclick>Skin.SetString(pointer,inverse)</onclick>
          <selected>String.IsEqual(Skin.String(pointer),inverse)</selected>
        </control>
        <!-- Touch mode pointer: Auto (mousewatch.py looks for a mouse), Always,
             Never. Each tap steps on; all conditions are read before any action -->
        <control type="button" id="114">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31868]</label>
          <label2>$VAR[TouchPointerVar]</label2>
          <onclick condition="!Skin.HasSetting(touch.pointer.show) + !Skin.HasSetting(touch.pointer.hide)">Skin.SetBool(touch.pointer.show)</onclick>
          <onclick condition="Skin.HasSetting(touch.pointer.show)">Skin.Reset(touch.pointer.show)</onclick>
          <onclick condition="Skin.HasSetting(touch.pointer.show)">Skin.SetBool(touch.pointer.hide)</onclick>
          <onclick condition="Skin.HasSetting(touch.pointer.hide)">Skin.Reset(touch.pointer.hide)</onclick>
        </control>
        <control type="button" id="109">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31928]</label>
          <onclick>ActivateWindow(InterfaceSettings)</onclick>
        </control>
        <control type="button" id="110">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31953]</label>
          <onclick>ActivateWindow(1120)</onclick>
        </control>
        <control type="button" id="111">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31979]</label>
          <onclick>RunScript(special://skin/scripts/backup.py,backup)</onclick>
        </control>
        <control type="button" id="112">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31980]</label>
          <onclick>RunScript(special://skin/scripts/backup.py,restore)</onclick>
        </control>
        <!-- asks first (Reset / Back up first / Cancel) and keeps Touch mode -->
        <control type="button" id="104">
          <width>530</width><include content="Height_32_XL" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <include content="Height_32" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]" />
          <align>left</align><textoffsetx>12</textoffsetx>
          <label>$LOCALIZE[31865]...</label>
          <onclick>RunScript(special://skin/scripts/backup.py,reset)</onclick>
        </control>
      </control>
      <control type="scrollbar" id="98">
        <left>556</left><top>116</top><include content="Size_Width" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="30" /></include><include content="Size_Width" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="18" /></include><height>396</height>
        <onleft>99</onleft><onright>97</onright><onup>9100</onup><ondown>9100</ondown>
      </control>

      <control type="image">
        <left>600</left><top>116</top><width>380</width><height>396</height>
        <texture border="2" colordiffuse="facetint">panel_sunken.png</texture>
      </control>
      <!-- the help runs past the box with Extra large fonts: drag 97, or it
           scrolls by itself while its scrollbar is not focused -->
      <control type="textbox">
        <left>612</left><top>126</top><include content="Size_Width" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="314" /></include><include content="Size_Width" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="326" /></include><height>376</height>
        <font>small</font>
        <pagecontrol>97</pagecontrol>
        <autoscroll delay="6000" time="4000" repeat="8000">!Control.HasFocus(97)</autoscroll>
        <label>$LOCALIZE[31922][CR][CR]$LOCALIZE[31896]</label>
      </control>
      <control type="scrollbar" id="97">
        <include content="Size_Left" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="934" /></include><include content="Size_Left" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="946" /></include><top>126</top><include content="Size_Width" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="30" /></include><include content="Size_Width" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="18" /></include><height>376</height>
        <onleft>98</onleft><onup>9100</onup><ondown>9100</ondown>
      </control>
    </control>

    <include content="Chrome_Taskbar"><param name="up" value="100" /></include>
  </controls>
</window>
