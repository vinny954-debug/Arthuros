<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi does not fill this window; the sections below are the skin's own.
     Laid out as a control panel of icons, like the desktop. -->
<window>
  <defaultcontrol always="false">9200</defaultcontrol>
  <backgroundcolor>desktop</backgroundcolor>
  <controls>
    <include>Chrome_Desktop</include>
    <include>Chrome_Menubar</include>

    <control type="group">
      <left>6</left><top>30</top><width>1012</width><height>534</height>
      <include content="Win_Frame">
        <param name="width" value="1012" /><param name="height" value="534" />
      </include>
      <control type="group">
        <left>3</left><top>3</top>
        <include content="Win_Title">
          <param name="width" value="1006" />
          <param name="colour" value="accent1" />
          <param name="icon" value="icons24/settings.png" />
          <param name="label" value="$LOCALIZE[5]" />
          <param name="down" value="9200" />
          <param name="boxes" value="window" />
        </include>
      </control>

      <control type="image">
        <left>6</left><top>34</top><width>1000</width><height>494</height>
        <texture border="2" colordiffuse="facetint">panel_sunken_grey.png</texture>
      </control>

      <control type="panel" id="9200">
        <left>10</left><top>38</top><width>992</width><height>486</height>
        <onleft>9200</onleft><onright>9200</onright>
        <ondown>9100</ondown>
        <scrolltime tween="linear">0</scrolltime>
        <pagecontrol>-</pagecontrol>

        <!-- tile layouts from home.py (Includes_Home.xml): three rows fill
             the panel at 600 and at 768, icons at their native size, names
             in a textbox because list-layout labels never wrap -->
        <include>Settings_HubLayouts</include>

        <content>
          <item><label>$LOCALIZE[14200]</label><icon>icons/player.png</icon>
            <property name="ico">player</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(PlayerSettings)</onclick></item>
          <item><label>$LOCALIZE[14211]</label><icon>icons/media.png</icon>
            <property name="ico">media</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(MediaSettings)</onclick></item>
          <item><label>$LOCALIZE[14206]</label><icon>icons/interface.png</icon>
            <property name="ico">interface</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(InterfaceSettings)</onclick></item>
          <item><label>$LOCALIZE[20077]</label><icon>icons/skin.png</icon>
            <property name="ico">skin</property>
            <property name="bar">accent1</property>
            <onclick>ActivateWindow(SkinSettings)</onclick></item>
          <item><label>$LOCALIZE[14036]</label><icon>icons/services.png</icon>
            <property name="ico">services</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(ServiceSettings)</onclick></item>
          <item><label>$LOCALIZE[13000]</label><icon>icons/system.png</icon>
            <property name="ico">system</property>
            <property name="bar">accent1</property>
            <onclick>ActivateWindow(SystemSettings)</onclick></item>
          <item><label>$LOCALIZE[19020]</label><icon>icons/livetv.png</icon>
            <property name="ico">livetv</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(PVRSettings)</onclick>
            <visible>System.HasPVRAddon</visible></item>
          <item><label>$LOCALIZE[15016]</label><icon>icons/games.png</icon>
            <property name="ico">games</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(GameSettings)</onclick></item>
          <item><label>$LOCALIZE[24001]</label><icon>icons/addons.png</icon>
            <property name="ico">addons</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(AddonBrowser,addons://,return)</onclick></item>
          <item><label>$LOCALIZE[7]</label><icon>icons/harddisk.png</icon>
            <property name="ico">harddisk</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(FileManager)</onclick></item>
          <item><label>$LOCALIZE[10007]</label><icon>icons/info.png</icon>
            <property name="ico">info</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(SystemInfo)</onclick></item>
          <item><label>$LOCALIZE[13200]</label><icon>icons/person.png</icon>
            <property name="ico">person</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(Profiles)</onclick></item>
          <item><label>$LOCALIZE[14111]</label><icon>icons/events.png</icon>
            <property name="ico">events</property>
            <property name="bar">accent2</property>
            <onclick>ActivateWindow(EventLog)</onclick></item>
          <item><label>LibreELEC</label><icon>icons/tools.png</icon>
            <property name="ico">tools</property>
            <property name="bar">accent1</property>
            <onclick>RunAddon(service.libreelec.settings)</onclick>
            <visible>System.HasAddon(service.libreelec.settings)</visible></item>
          <!-- on plain Linux, the skin's own Wi-Fi / Bluetooth / sound output settings -->
          <item><label>$LOCALIZE[31996]</label><icon>icons/network.png</icon>
            <property name="ico">network</property>
            <property name="bar">accent1</property>
            <onclick>RunScript(special://skin/scripts/netbt.py)</onclick>
            <visible>!System.HasAddon(service.libreelec.settings) + System.Platform.Linux + !System.Platform.Android</visible></item>
          <!-- Shut down / Reboot: at most 15 items show, which the 5 x 3 panel holds -->
          <item><label>$LOCALIZE[31976]</label><icon>icons/power.png</icon>
            <property name="ico">power</property>
            <property name="bar">accent1</property>
            <onclick>ActivateWindow(ShutdownMenu)</onclick></item>
        </content>
      </control>
    </control>

    <include content="Chrome_Taskbar"><param name="up" value="9200" /></include>
  </controls>
</window>
