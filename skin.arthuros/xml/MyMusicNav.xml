<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol always="false">50</defaultcontrol>
  <!-- which add-on was open, for the OSD's Add-on settings button -->
  <onunload>SetProperty(arthuros.plugin,$INFO[Container.PluginName],home)</onunload>
  <views>50,51,52</views>
  <backgroundcolor>desktop</backgroundcolor>
  <controls>
    <include>Chrome_Desktop</include>
    <include>Chrome_Menubar</include>
    <control type="group">
      <left>6</left><top>30</top><width>1012</width><height>534</height>
      <!-- second toolbar row: this window's own buttons (Kodi's ids) -->
      <include content="Media_Window_Extras">
        <param name="icon" value="icons24/music.png" />
        <param name="colour" value="accent2" />
        <param name="extras" value="Media_Extras_MusicNav" />
      </include>
    </control>
    <include content="Chrome_Taskbar"><param name="up" value="50" /></include>
  </controls>
</window>
