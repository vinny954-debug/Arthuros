<?xml version="1.0" encoding="UTF-8"?>
<!-- Detailed list. Lives inside the media window's view group (634x462). -->
<includes>
  <include name="View_50_List">
    <!-- height: the views area; inner = height-6; up: the toolbar row above -->
    <param name="height" default="462" />
    <param name="inner" default="456" />
    <param name="up" default="9490" />
    <definition>
    <control type="group">
      <visible>Control.IsVisible(50)</visible>
      <include content="Arthur_ListWell">
        <param name="width" value="634" />
        <param name="height" value="$PARAM[height]" />
      </include>
    </control>

    <control type="list" id="50">
      <!-- the name Kodi shows on the View button ("View: List") -->
      <viewtype label="535">list</viewtype>
      <left>3</left><top>3</top><include content="Size_Width" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="592" /></include><include content="Size_Width" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="604" /></include><height>$PARAM[inner]</height>
      <onleft>9490</onleft>
      <onright>60</onright>
      <onup>$PARAM[up]</onup>
      <ondown>9100</ondown>
      <pagecontrol>60</pagecontrol>
      <scrolltime tween="linear">0</scrolltime>
      <itemlayout height="40" width="592" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]">
        <include content="Arthur_ItemLayout_XL"><param name="width" value="584" /></include>
      </itemlayout>
      <focusedlayout height="40" width="592" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]">
        <include content="Arthur_FocusedLayout_XL"><param name="width" value="592" /></include>
      </focusedlayout>
      <itemlayout height="24" width="604">
        <include content="Arthur_ItemLayout"><param name="width" value="596" /></include>
      </itemlayout>
      <focusedlayout height="24" width="604">
        <include content="Arthur_FocusedLayout"><param name="width" value="604" /></include>
      </focusedlayout>
    </control>

    <control type="scrollbar" id="60">
      <include content="Size_Left" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="599" /></include><include content="Size_Left" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="611" /></include><top>3</top><include content="Size_Width" condition="[String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="30" /></include><include content="Size_Width" condition="![String.StartsWith(Skin.Font,ExtraLarge) | Skin.HasSetting(touchmode)]"><param name="v" value="18" /></include><height>$PARAM[inner]</height>
      <onleft>50</onleft>
      <onright>9490</onright>
      <visible>Control.IsVisible(50)</visible>
    </control>
    </definition>
  </include>
</includes>
